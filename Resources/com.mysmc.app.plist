<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Label must be unique — matches the filename stem -->
    <key>Label</key>
    <string>com.mysmc.app</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Applications/MySMC.app/Contents/MacOS/MySMC</string>
    </array>

    <!-- Run as root so the SMC can be controlled without per-launch auth prompts -->
    <key>UserName</key>
    <string>root</string>

    <!-- Start automatically when the user logs in -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Do not restart if the user quits the app from the menu -->
    <key>KeepAlive</key>
    <false/>
</dict>
</plist>
